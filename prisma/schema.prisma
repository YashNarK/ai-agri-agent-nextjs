generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["agricultural", "public"]
}

model agronomic_knowledge {
  id             BigInt                 @id @default(autoincrement())
  title          String                 @db.VarChar(500)
  content        String
  category       String?                @db.VarChar(100)
  crop_id        Int?
  region_id      Int?
  source         String?                @db.VarChar(200)
  published_date DateTime?              @db.Date
  embedding      Unsupported("vector")?
  metadata       Json?
  created_at     DateTime               @default(now()) @db.Timestamptz(6)
  crops          crops?                 @relation(fields: [crop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions        regions?               @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category, crop_id], map: "idx_agronomic_knowledge_category_crop")
  @@index([embedding], map: "idx_agronomic_knowledge_embedding")
  @@schema("agricultural")
}

model chat_messages {
  id              BigInt        @id @default(autoincrement())
  session_id      String        @db.Uuid
  role            String        @db.VarChar(20)
  content         String
  tool_calls      Json?
  tool_results    Json?
  langgraph_state Json?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  chat_sessions   chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, created_at], map: "idx_chat_messages_session")
  @@schema("agricultural")
}

model chat_sessions {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String?         @db.VarChar(100)
  session_name  String?         @db.VarChar(200)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  metadata      Json?
  chat_messages chat_messages[]

  @@schema("agricultural")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model crop_price_history {
  id              BigInt   @default(autoincrement())
  crop_id         Int
  region_id       Int
  price_date      DateTime @db.Date
  price_usd_tonne Decimal  @db.Decimal(10, 2)
  price_local     Decimal? @db.Decimal(10, 2)
  local_currency  String?  @db.VarChar(10)
  volume_traded   Decimal? @db.Decimal(15, 2)
  source          String?  @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  crops           crops    @relation(fields: [crop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions         regions  @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, price_date])
  @@index([crop_id, region_id, price_date(sort: Desc)], map: "idx_price_history_crop_region_date")
  @@schema("agricultural")
}

model crop_yield_history {
  id                      Int      @id @default(autoincrement())
  crop_id                 Int
  region_id               Int
  harvest_year            Int
  yield_tonnes_ha         Decimal  @db.Decimal(10, 4)
  area_harvested_ha       Decimal? @db.Decimal(15, 2)
  total_production_tonnes Decimal? @db.Decimal(15, 2)
  quality_grade           String?  @db.VarChar(10)
  notes                   String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  crops                   crops    @relation(fields: [crop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions                 regions  @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([crop_id, region_id, harvest_year])
  @@index([crop_id, region_id, harvest_year(sort: Desc)], map: "idx_yield_crop_region_year")
  @@schema("agricultural")
}

model crops {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique @db.VarChar(20)
  name                String                @db.VarChar(100)
  category            String                @db.VarChar(50)
  sub_category        String?               @db.VarChar(50)
  scientific_name     String?               @db.VarChar(150)
  growing_season      String?               @db.VarChar(50)
  avg_yield_per_ha    Decimal?              @db.Decimal(10, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  agronomic_knowledge agronomic_knowledge[]
  crop_price_history  crop_price_history[]
  crop_yield_history  crop_yield_history[]
  price_predictions   price_predictions[]
  products            products[]

  @@schema("agricultural")
}

model market_indicators {
  id              BigInt   @id @default(autoincrement())
  indicator_date  DateTime @db.Date
  indicator_name  String   @db.VarChar(100)
  indicator_value Decimal  @db.Decimal(15, 4)
  unit            String?  @db.VarChar(50)
  source          String?  @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([indicator_date, indicator_name])
  @@index([indicator_name, indicator_date(sort: Desc)], map: "idx_market_indicators_name_date")
  @@schema("agricultural")
}

model price_predictions {
  id              BigInt   @id @default(autoincrement())
  crop_id         Int
  region_id       Int
  prediction_date DateTime @default(now()) @db.Timestamptz(6)
  target_date     DateTime @db.Date
  predicted_price Decimal  @db.Decimal(10, 2)
  confidence_low  Decimal? @db.Decimal(10, 2)
  confidence_high Decimal? @db.Decimal(10, 2)
  model_version   String?  @db.VarChar(50)
  features_used   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  crops           crops    @relation(fields: [crop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regions         regions  @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([crop_id, region_id, target_date(sort: Desc)], map: "idx_price_predictions_crop_region")
  @@schema("agricultural")
}

model product_knowledge {
  id         BigInt                 @id @default(autoincrement())
  product_id Int?
  title      String                 @db.VarChar(500)
  content    String
  doc_type   String?                @db.VarChar(100)
  embedding  Unsupported("vector")?
  metadata   Json?
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  products   products?              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([embedding], map: "idx_product_knowledge_embedding")
  @@schema("agricultural")
}

model products {
  id                Int                 @id @default(autoincrement())
  sku               String              @unique @db.VarChar(50)
  name              String              @db.VarChar(200)
  category          String              @db.VarChar(50)
  sub_category      String?             @db.VarChar(50)
  crop_id           Int?
  description       String?
  active_ingredient String?             @db.VarChar(200)
  unit_of_measure   String              @db.VarChar(20)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  product_knowledge product_knowledge[]
  crops             crops?              @relation(fields: [crop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("agricultural")
}

model regions {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique @db.VarChar(10)
  name                String                @db.VarChar(100)
  country             String                @db.VarChar(100)
  climate             String?               @db.VarChar(50)
  latitude            Decimal?              @db.Decimal(9, 6)
  longitude           Decimal?              @db.Decimal(9, 6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  agronomic_knowledge agronomic_knowledge[]
  crop_price_history  crop_price_history[]
  crop_yield_history  crop_yield_history[]
  price_predictions   price_predictions[]
  weather_data        weather_data[]

  @@schema("agricultural")
}

model weather_data {
  id              BigInt   @id @default(autoincrement())
  region_id       Int
  weather_date    DateTime @db.Date
  temp_max_c      Decimal? @db.Decimal(5, 2)
  temp_min_c      Decimal? @db.Decimal(5, 2)
  temp_avg_c      Decimal? @db.Decimal(5, 2)
  rainfall_mm     Decimal? @db.Decimal(8, 2)
  humidity_pct    Decimal? @db.Decimal(5, 2)
  wind_speed_kmh  Decimal? @db.Decimal(6, 2)
  solar_radiation Decimal? @db.Decimal(8, 2)
  drought_index   Decimal? @db.Decimal(5, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  regions         regions  @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([region_id, weather_date])
  @@index([region_id, weather_date(sort: Desc)], map: "idx_weather_region_date")
  @@schema("agricultural")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model app_users {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String?   @db.VarChar(320)
  github_login  String?   @db.VarChar(100)
  name          String?   @db.VarChar(200)
  image         String?
  password_hash String?   @db.VarChar(255)
  role          String    @default("user") @db.VarChar(20)
  status        String    @default("pending") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_login_at DateTime? @db.Timestamptz(6)
  approved_at   DateTime? @db.Timestamptz(6)
  approved_by   String?   @db.Uuid

  @@index([status, created_at(sort: Desc)], map: "idx_app_users_status")
  @@schema("agricultural")
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
  @@schema("public")
}

model checkpoint_migrations {
  v Int @id

  @@schema("public")
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@schema("public")
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@schema("public")
}
