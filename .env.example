# ============================================================
# .env.example — copy to .env.local (Next.js) or .env
#
# Only AWS credentials belong here (so the AWS SDK can reach
# Secrets Manager + SSM). Everything else has non-secret defaults
# in lib/config/settings.ts; override any of them with an env var
# per deployment if needed.
#
# Real secrets   -> AWS Secrets Manager (prod/agri/*)
# Non-secret cfg -> AWS SSM Parameter Store (/prod/agri/*)
#
# On AWS compute, omit these keys and use an IAM role instead.
# ============================================================

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ------------------------------------------------------------
# DATABASE_URL is OPTIONAL at runtime — when unset, the app
# resolves the Neon connection string from the DB secret in AWS
# Secrets Manager, exactly like the Python app did.
#
# It IS required for the Prisma CLI (`prisma generate`,
# `prisma db pull`, `prisma migrate`), which cannot call AWS.
# When set, it also short-circuits the AWS lookup at runtime.
# ------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Optional overrides (defaults live in lib/config/settings.ts):
# AWS_REGION=ap-south-1
# DEBUG=true
# DB_SSL=true
# DB_SECRET_NAME=prod/agri/database
# AZURE_OPENAI_SECRET_NAME=prod/agri/azure-openai
# AZURE_ML_SECRET_NAME=prod/agri/azure-ml
