# ============================================================
# .env.example — copy to .env.local (Next.js) or .env
#
# Only AWS credentials belong here (so the AWS SDK can reach
# Secrets Manager + SSM). Everything else has non-secret defaults
# in lib/config/settings.ts; override any of them with an env var
# per deployment if needed.
#
# Real secrets   -> AWS Secrets Manager (prod/agri/*)
# Non-secret cfg -> AWS SSM Parameter Store (/prod/agri/*)
#
# On AWS compute, omit these keys and use an IAM role instead.
#
# NOTE the APP_ prefix. $AWS_ACCESS_KEY_ID, $AWS_SECRET_ACCESS_KEY and
# $AWS_SESSION_TOKEN are reserved Lambda runtime variables, and Vercel
# functions are Lambdas: the runtime injects its own execution-role values.
# Set the unprefixed names and the SDK silently pairs your key with the
# platform's session token, which AWS rejects as an invalid security token.
# ============================================================

APP_AWS_ACCESS_KEY_ID=your-access-key-id
APP_AWS_SECRET_ACCESS_KEY=your-secret-access-key
# APP_AWS_SESSION_TOKEN=   # only for temporary/STS credentials

# ------------------------------------------------------------
# Neon exposes two endpoints, and they are not interchangeable:
#
#   DATABASE_URL  -> the *-pooler host. PgBouncer in transaction
#                    mode. Used for all app CRUD traffic.
#   DIRECT_URL    -> the direct host (no -pooler). Used for DDL:
#                    prisma migrate / db push / db pull, and the
#                    sql/ runner. Migrations take session advisory
#                    locks that transaction pooling cannot hold.
#
# Both are OPTIONAL at runtime — when unset, the app reads
# `database_url` and `direct_database_url` from the DB secret in
# AWS Secrets Manager, exactly like the Python app did.
#
# At least DIRECT_URL (or DATABASE_URL as a fallback) IS required
# for the Prisma CLI, which cannot call AWS. See prisma.config.ts.
# When set, they short-circuit the AWS lookup at runtime.
# ------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ------------------------------------------------------------
# IDENTITY AND ACCESS (required)
#
# Two gates. GitHub proves who you are; the admin decides whether you
# may spend anything. Every account is created 'pending' and can reach
# nothing that calls Azure until approved.
# ------------------------------------------------------------

# Signs the session JWT. Generate with:  openssl rand -base64 32
# Changing it invalidates every existing session.
AUTH_SECRET=

# GitHub OAuth app — one per environment, because the callback URL is
# fixed per app. Callback: <origin>/api/auth/callback/github
#   dev:  http://localhost:3000/api/auth/callback/github
#   prod: https://your-domain/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The bootstrap admin. This account skips the approval queue — without
# it there would be nobody able to approve the first user.
# ADMIN_GITHUB_LOGIN is matched case-insensitively against the GitHub
# username; ADMIN_EMAIL is the only address allowed to use a password.
ADMIN_GITHUB_LOGIN=YashNarK
ADMIN_EMAIL=narenkrithick@gmail.com

# bcrypt hash, never the plaintext. Generate with:
#   npm run hash:password -- 'your password'
# Leave empty to disable password sign-in entirely (GitHub still works).
ADMIN_PASSWORD_HASH=

# Bearer token for the MCP endpoint (/api/mcp/*). MCP exposes the same
# prediction and search tools as the guarded REST routes, and its
# clients are other AI systems rather than browsers, so it authenticates
# with a token instead of a cookie. Generate with:
#   openssl rand -hex 32
# UNSET MEANS CLOSED: with no token configured the endpoint refuses
# every request rather than serving them unauthenticated.
MCP_API_TOKEN=

# Optional overrides (defaults live in lib/config/settings.ts):
#
# NOTE: the region variable is APP_AWS_REGION, not AWS_REGION. $AWS_REGION is
# a reserved Lambda runtime variable — on Vercel (whose functions are Lambdas)
# the runtime sets it to the function's own region, which silently points the
# SDK at the wrong endpoint. Leave it unset to get ap-south-1.
# APP_AWS_REGION=ap-south-1
# DEBUG=true
# DB_SSL=true
# DB_SECRET_NAME=prod/agri/database
# AZURE_OPENAI_SECRET_NAME=prod/agri/azure-openai
# AZURE_ML_SECRET_NAME=prod/agri/azure-ml
